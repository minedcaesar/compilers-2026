// EXPECT: 81
// A1 example 6: scoping and edge cases of the desugaring.
//  - the loop variable is local to the `for`, so `i` can be reused;
//  - the init clause may assign an existing variable instead of declaring one;
//  - a `for` whose guard is false at the start never runs its body;
//  - `do {...} while (false)` runs its body exactly once.
main() : int {
    s: int = 0
    for i: int = 0; i < 3; i = i + 1 {
        s = s + 1
    }
    for i: int = 0; i < 3; i = i + 1 {
        s = s + 10
    }

    k: int = 0
    for k = 10; k > 0; k = k - 5 {
        s = s + 1
    }
    // k survives the loop because it was declared outside: k == 0
    // (so far: 3 + 30 + 2 iterations = 35)
    s = s + k

    for j: int = 5; j < 0; j = j + 1 {
        s = s + 1000
    }

    do {
        s = s + 46
    } while (false)
    return s
}
